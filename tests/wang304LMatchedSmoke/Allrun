#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
SOURCE_CASE="$REPO_ROOT/tutorials/vacuumLaserbeamFoam/wang2020_304L_nearVacuum"
RUN_CASE="$REPO_ROOT/tests/run/wang304LMatchedSmoke"

rm -rf "$RUN_CASE"
mkdir -p "$RUN_CASE"
cp -a "$SOURCE_CASE/initial" "$RUN_CASE/"
cp -a "$SOURCE_CASE/constant" "$RUN_CASE/"
cp -a "$SOURCE_CASE/system" "$RUN_CASE/"

cd "$RUN_CASE"

cp system/blockMeshDict.smoke8um system/blockMeshDict
cp system/controlDict.smoke10us system/controlDict

echo "Copying 'initial' to 0"
cp -r initial 0

. $WM_PROJECT_DIR/bin/tools/RunFunctions

runApplication blockMesh
runApplication setFields
runApplication decomposePar
runParallel vacuumLaserbeamFoam

if ! grep -q 'Laser optics laser0: opticalModel=fixedComplexIndex' \
    log.vacuumLaserbeamFoam
then
    echo "Missing fixedComplexIndex optical selection" >&2
    exit 1
fi

if ! grep -q 'Vacuum radiation model' log.vacuumLaserbeamFoam
then
    echo "Missing vacuum radiation model startup" >&2
    exit 1
fi

if ! grep -q 'interfacePVapMax=' log.vacuumLaserbeamFoam
then
    echo "Missing interface recoil diagnostic" >&2
    exit 1
fi

if ! grep -q 'radiationPower=' log.vacuumLaserbeamFoam
then
    echo "Missing radiation power diagnostic" >&2
    exit 1
fi

if grep -Eq 'FOAM FATAL ERROR|MPI_ABORT was invoked' log.vacuumLaserbeamFoam
then
    echo "Matched-physics smoke ended with a fatal solver error" >&2
    exit 1
fi

if grep -Eiq '(^|[^A-Za-z])(nan|inf)([^A-Za-z]|$)' log.vacuumLaserbeamFoam
then
    echo "Matched-physics smoke contains NaN/Inf" >&2
    exit 1
fi

if ! grep -q '^End log.vacuumLaserbeamFoam
then
    echo "Matched-physics smoke did not reach End" >&2
    exit 1
fi

LATEST_DIAG="$(grep '^VACUUM_DIAGNOSTICS ' log.vacuumLaserbeamFoam | tail -1)"

echo "$LATEST_DIAG" | awk '
{
    for (i=1; i<=NF; ++i)
    {
        split($i, a, "=");
        if (a[1] == "depositedPower") deposited=a[2]+0;
        if (a[1] == "interfacePVapMax") recoil=a[2]+0;
        if (a[1] == "evaporationPower") evap=a[2]+0;
        if (a[1] == "radiationPower") rad=a[2]+0;
    }

    if (!(deposited > 0)) exit 31;
    if (!(recoil > 0)) exit 32;
    if (!(evap > 0)) exit 33;
    if (!(rad > 0)) exit 34;
}'

if [ $? -ne 0 ]; then
    echo "Matched-physics diagnostic values did not activate as expected" >&2
    exit 1
fi

echo
echo "Selected optics:"
grep 'Laser optics laser0:' log.vacuumLaserbeamFoam | head -1

echo "First matched-physics diagnostics:"
grep '^VACUUM_DIAGNOSTICS ' log.vacuumLaserbeamFoam | head -1

echo "Latest matched-physics diagnostics:"
echo "$LATEST_DIAG"

echo "PASS: Wang 304L matched-physics 48-rank smoke"
