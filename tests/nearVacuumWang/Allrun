#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
SOURCE_CASE="$REPO_ROOT/tutorials/vacuumLaserbeamFoam/bootstrapPlate2D"
RUN_CASE="$REPO_ROOT/tests/run/nearVacuumWang"

rm -rf "$RUN_CASE"
mkdir -p "$(dirname "$RUN_CASE")"
cp -a "$SOURCE_CASE" "$RUN_CASE"
cp "$SCRIPT_DIR/vacuumProperties" "$RUN_CASE/constant/vacuumProperties"

(
    cd "$RUN_CASE"
    blockMesh > log.blockMesh 2>&1
)

run_model()
{
    local temperature="$1"
    local label="$2"

    foamDictionary "$RUN_CASE/constant/vacuumProperties"         -entry testTemperature -set "$temperature" > /dev/null

    (
        cd "$RUN_CASE"
        vacuumEvaporationModelTest > "log.model.$label" 2>&1
    )

    grep '^EVAP_MODEL_TEST ' "$RUN_CASE/log.model.$label" | tail -1
}

# At the default metal liquidus (1723 K), the 0.6 Pa synthetic reference has
# Tk1 below the active liquid regime, so the model must reduce to Ma=1.
line="$(run_model 3000 sonicTargetPressure)"
read -r tag T pSat mDot recoil qEvap <<< "$line"

awk -v T="$T" -v pSat="$pSat" -v mDot="$mDot" -v recoil="$recoil" -v q="$qEvap" '
BEGIN {
    ePsat=84212.46708506653;
    eMdot=38.79948612505068;
    eRecoil=46301.62063810318;
    eQ=23279691.675030407;
    tol=3e-9;
    if (T != 3000) exit 11;
    if (sqrt((pSat-ePsat)^2) > tol*ePsat) exit 12;
    if (sqrt((mDot-eMdot)^2) > tol*eMdot) exit 13;
    if (sqrt((recoil-eRecoil)^2) > tol*eRecoil) exit 14;
    if (sqrt((q-eQ)^2) > tol*eQ) exit 15;
}'

grep -q "active regime        = sonic" "$RUN_CASE/log.model.sonicTargetPressure"

echo "PASS: nearVacuumWang sonic branch at 0.6 Pa"

# Force a low liquidus solely in this constitutive regression so that the
# transition interval [Tk0,Tk1] overlaps the active liquid state.
sed -i '0,/Tliquidus[[:space:]]*1723;/s//Tliquidus           300;/'     "$RUN_CASE/constant/transportProperties"

line="$(run_model 320 transitionState)"
read -r tag T pSat mDot recoil qEvap <<< "$line"

awk -v T="$T" -v pSat="$pSat" -v mDot="$mDot" -v recoil="$recoil" -v q="$qEvap" '
BEGIN {
    ePsat=3.5527716150516935;
    eMdot=0.0047650993277801095;
    eRecoil=1.4552667775493813;
    eQ=2859.0595966680658;
    tol=5e-8;
    if (T != 320) exit 21;
    if (sqrt((pSat-ePsat)^2) > tol*(ePsat>1?ePsat:1)) exit 22;
    if (sqrt((mDot-eMdot)^2) > tol*(eMdot>1?eMdot:1)) exit 23;
    if (sqrt((recoil-eRecoil)^2) > tol*(eRecoil>1?eRecoil:1)) exit 24;
    if (sqrt((q-eQ)^2) > tol*eQ) exit 25;
}'

grep -q "active regime        = transition-to-sonic"     "$RUN_CASE/log.model.transitionState"

echo "PASS: nearVacuumWang transition branch at 320 K"

# Below the configured liquidus the liquid-evaporation model must be inactive.
line="$(run_model 290 belowLiquidus)"
read -r tag T pSat mDot recoil qEvap <<< "$line"

awk -v mDot="$mDot" -v recoil="$recoil" -v q="$qEvap" '
BEGIN {
    if (mDot != 0 || recoil != 0 || q != 0) exit 31;
}'

echo "PASS: nearVacuumWang inactive below liquidus"

# Restore production-like liquidus and run one coupled time step.
sed -i '0,/Tliquidus[[:space:]]*300;/s//Tliquidus           1723;/'     "$RUN_CASE/constant/transportProperties"
foamDictionary "$RUN_CASE/constant/vacuumProperties"     -entry testTemperature -set 3000 > /dev/null

rm -rf "$RUN_CASE/0"
cp -a "$RUN_CASE/initial" "$RUN_CASE/0"

(
    cd "$RUN_CASE"
    foamDictionary system/controlDict -entry stopAt -set nextWrite
    foamDictionary system/controlDict -entry writeControl -set timeStep
    foamDictionary system/controlDict -entry writeInterval -set 1
    setFields > log.setFields 2>&1
    vacuumLaserbeamFoam > log.vacuumLaserbeamFoam 2>&1
)

grep -q "Selecting vacuum evaporation model nearVacuumWang"     "$RUN_CASE/log.vacuumLaserbeamFoam"
grep -q "active regime        = sonic" "$RUN_CASE/log.vacuumLaserbeamFoam"

latest_time="$(foamListTimes -case "$RUN_CASE" -latestTime | tail -1)"
qv="$RUN_CASE/$latest_time/Qv"

if [[ ! -f "$qv" ]]; then
    echo "Missing Qv output field" >&2
    exit 41
fi

if grep -Eiq '(^|[^A-Za-z])(nan|inf)([^A-Za-z]|$)' "$qv"; then
    echo "Non-finite value detected in Qv" >&2
    exit 42
fi

echo "PASS: nearVacuumWang constitutive and CFD-coupling regression"
