#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
SOURCE_CASE="$REPO_ROOT/tutorials/vacuumLaserbeamFoam/bootstrapPlate2D"
RUN_CASE="$REPO_ROOT/tests/run/knudsenTransition"

rm -rf "$RUN_CASE"
mkdir -p "$(dirname "$RUN_CASE")"
cp -a "$SOURCE_CASE" "$RUN_CASE"

(
    cd "$RUN_CASE"
    knudsenTransitionTest > log.knudsenTransitionTest 2>&1
)

mapfile -t lines < <(
    grep '^KNUDSEN_TRANSITION_TEST ' "$RUN_CASE/log.knudsenTransitionTest"
)

if [[ "${#lines[@]}" -ne 3 ]]
then
    echo "Expected 3 transition-test states, got ${#lines[@]}" >&2
    exit 1
fi

expected_Ma=(0.05 0.5 1.0)
expected_M2=(1.1097782630337711 2.334163368386289 3.7179376929830426)

for i in 0 1 2
do
    read -r tag targetMa ambientP recoveredMa recoveredT M2 machOk tempOk <<< "${lines[$i]}"

    awk         -v target="$targetMa"         -v recovered="$recoveredMa"         -v T="$recoveredT"         -v M2="$M2"         -v expectedMa="${expected_Ma[$i]}"         -v expectedM2="${expected_M2[$i]}"         -v machOk="$machOk"         -v tempOk="$tempOk"         'BEGIN {
            if (machOk != 1 || tempOk != 1) exit 11;
            if (target < expectedMa-1e-12 || target > expectedMa+1e-12) exit 12;
            if (recovered < expectedMa-2e-8 || recovered > expectedMa+2e-8) exit 13;
            if (T < 2999.9998 || T > 3000.0002) exit 14;
            if (M2 < expectedM2-2e-8 || M2 > expectedM2+2e-8) exit 15;
        }'

    echo "PASS: transition state Ma=${expected_Ma[$i]} recoveredMa=$recoveredMa recoveredT=$recoveredT M2=$M2"
done

echo "PASS: Eq. (16)-(17) transition relation regression"
