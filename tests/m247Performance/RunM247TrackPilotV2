#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/../.."
if [ "$#" -ne 1 ]; then
    echo "Usage: bash tests/m247Performance/RunM247TrackPilotV2 PATH_TO_DEM_REVIEW.tar.gz" >&2
    exit 2
fi
DEM_ARCHIVE=$(realpath "$1")
test -f "$DEM_ARCHIVE" || { echo "Missing DEM archive: $DEM_ARCHIVE" >&2; exit 2; }
WORK=tests/m247Performance/runs/m247-track1500-v2-pilot-$(date +%Y%m%d-%H%M%S)
mkdir -p "$WORK"
WORK=$(cd "$WORK" && pwd -P)
package() {
    code=$?
    trap - EXIT
    python3 tests/m247Performance/track1500_pilot_v2.py --work "$WORK" --package --exit-code "$code" || code=1
    exit "$code"
}
trap package EXIT
git rev-parse HEAD > "$WORK/revision.txt"
printf 'WM_PROJECT_VERSION=%s\nWM_PROJECT_DIR=%s\n' "${WM_PROJECT_VERSION:-unset}" "${WM_PROJECT_DIR:-unset}" > "$WORK/openfoamVersion.txt"
case "${WM_PROJECT_VERSION:-}" in
    v2512|2512) ;;
    *) echo "M247 V2 pilot requires OpenFOAM-v2512; current WM_PROJECT_VERSION=${WM_PROJECT_VERSION:-unset}" >&2; exit 2 ;;
esac
python3 tests/m247Performance/m247_dem_handoff.py "$DEM_ARCHIVE" "$WORK/dem"
for tool in python3 wclean wmake wmakeLnInclude blockMesh setFields checkMesh decomposePar mpirun reconstructPar postProcess; do
    command -v "$tool" >/dev/null || { echo "Missing $tool; source OpenFOAM first"; exit 1; }
done
# Refresh stale absolute paths in Make/*.dep using official OpenFOAM commands.
(cd src/laserHeatSource && wclean libso && wmakeLnInclude -u . && test -r lnInclude/laserPerformance.H && wmake libso) 2>&1 | tee "$WORK/buildLaser.log"
(cd applications/solvers/vacuumLaserbeamFoam && wclean && wmake) 2>&1 | tee "$WORK/buildSolver.log"
python3 tests/m247Performance/check_solver.py --laser-profile --output "$WORK/solverCheck.json"
python3 tests/m247Performance/track1500_pilot_v2.py --work "$WORK" 2>&1 | tee "$WORK/collection.log"

