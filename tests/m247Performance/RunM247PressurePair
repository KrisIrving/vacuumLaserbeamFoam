#!/bin/bash
set -euo pipefail
if [ "$#" -ne 1 ]; then
    echo "Usage: bash tests/m247Performance/RunM247PressurePair /path/to/completed/pilot/track1500"
    exit 2
fi
SOURCE=$(cd "$1" && pwd -P)
cd "$(dirname "$0")/../.."
WORK=tests/m247Performance/runs/m247-pressure-pair-$(date +%Y%m%d-%H%M%S)
mkdir -p "$WORK"
WORK=$(cd "$WORK" && pwd -P)
package() {
    code=$?
    trap - EXIT
    python3 tests/m247Performance/track_pressure_pair.py --work "$WORK" --package --exit-code "$code" || code=1
    exit "$code"
}
trap package EXIT
git rev-parse HEAD > "$WORK/revision.txt"
for tool in python3 foamDictionary wmake mpirun reconstructPar postProcess; do
    command -v "$tool" >/dev/null || { echo "Missing $tool; source OpenFOAM first"; exit 1; }
done
(cd src/laserHeatSource && wmake libso) 2>&1 | tee "$WORK/buildLaser.log"
(cd applications/solvers/vacuumLaserbeamFoam && wmake) 2>&1 | tee "$WORK/buildSolver.log"
python3 tests/m247Performance/check_solver.py --laser-profile --output "$WORK/solverCheck.json"
python3 tests/m247Performance/track_pressure_pair.py --source "$SOURCE" --work "$WORK" 2>&1 | tee "$WORK/collection.log"
