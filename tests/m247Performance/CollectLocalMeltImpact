#!/bin/bash
# Existing CSV/profile analysis only. No OpenFOAM commands or CFD.
set -euo pipefail
cd "$(dirname "$0")/../.."
SOURCE=${1:-tests/m247Performance/runs/local-melt-prepared-pair-20261009-213729}
[[ -f "$SOURCE/localMeltPairReview.json" ]] || { echo "Missing completed pair: $SOURCE"; exit 1; }
WORK=tests/m247Performance/runs/local-melt-impact-$(date +%Y%m%d-%H%M%S)
mkdir "$WORK"
WORK=$(cd "$WORK" && pwd -P)
package() {
    code=$?
    trap - EXIT
    python3 tests/m247Performance/package_results.py --work "$WORK" --exit-code "$code" || code=1
    exit "$code"
}
trap package EXIT
python3 tests/m247Performance/local_melt_localization.py --source "$SOURCE" --work "$WORK" 2>&1 | tee "$WORK/collection.log"
