#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/../.."
PREVIOUS=${1:-tests/m247Performance/runs/moving-window-protected-20261008-164709}
WORK=${2:-tests/m247Performance/runs/moving-mesh-pair-$(date +%Y%m%d-%H%M%S)}
[[ ! -e "$WORK" ]] || { echo "Choose fresh WORK" >&2; exit 1; }
mkdir -p "$WORK"
TAG=$(basename "$WORK")
BASE="$WORK/${TAG}-1step"
CAND="$WORK/${TAG}-4step"
bundle() {
    local status=$?
    trap - EXIT
    for item in "reference:$BASE" "candidate:$CAND"; do
        local name=${item%%:*} run=${item#*:}
        if [[ -f "$run/movingCFD/log.vacuumLaserbeamFoam" ]]; then cp "$run/movingCFD/log.vacuumLaserbeamFoam" "$WORK/${name}LongSolver.log"; fi
        if [[ -f "$run/build.log" ]]; then cp "$run/build.log" "$WORK/${name}LongBuild.log"; fi
        if [[ -f "$run/collection.log" ]]; then cp "$run/collection.log" "$WORK/${name}LongCollection.log"; fi
        for item in "movingCFD_decompose.log:Decompose.log" "movingCFD_pilot.log:Pilot.log" "movingCFD/run.json:Run.json" "movingCFD/probe.json:Probe.json"; do
            local source=${item%%:*} target=${item#*:}
            if [[ -f "$run/$source" ]]; then cp "$run/$source" "$WORK/${name}Long${target}"; fi
        done
        if [[ -f "$run/movingCFDReview.json" ]]; then
            if [[ "$name" == reference ]]; then cp "$run/movingCFDReview.json" "$WORK/movingStepReference.json";
            else cp "$run/movingCFDReview.json" "$WORK/movingStepCandidate.json"; fi
        fi
    done
    local checked=0
    python3 tests/m247Performance/moving_completion.py --work "$WORK" --requested-status "$status" --duration-us 0.2 || checked=$?
    status=$checked
    if ! python3 tests/m247Performance/package_results.py --work "$WORK" --exit-code "$status"; then status=1; fi
    exit "$status"
}
trap bundle EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
./tests/m247Performance/RunMovingCFDPilot "$PREVIOUS" "$BASE"
./tests/m247Performance/RunMovingCFDPilot --mesh4 "$PREVIOUS" "$CAND"
python3 tests/m247Performance/compare_moving_steps.py --reference "$BASE/movingCFDReview.json" \
    --candidate "$CAND/movingCFDReview.json" --output "$WORK/movingStepComparison.json"
