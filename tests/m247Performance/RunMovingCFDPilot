#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/../.."
RESUME=false
MAX_DELTA_NS=5
DURATION_US=0.2
DEFAULT_PREVIOUS=tests/m247Performance/runs/moving-window-protected-20261008-164709
TAG=moving-cfd-pilot
if [[ "${1:-}" == "--resume" ]]; then
    RESUME=true
    DEFAULT_PREVIOUS=tests/m247Performance/runs/moving-cfd-pilot-20261008-172613
    TAG=moving-cfd-collection
    shift
fi
if [[ "${1:-}" == "--dt10" ]]; then
    [[ "$RESUME" == false ]] || { echo "--dt10 cannot resume" >&2; exit 1; }
    MAX_DELTA_NS=10
    TAG=moving-cfd-dt10
    shift
fi
if [[ "${1:-}" == "--long" ]]; then
    [[ "$RESUME" == false ]] || { echo "--long cannot resume" >&2; exit 1; }
    DURATION_US=0.4
    TAG="${TAG}-long"
    shift
fi
PREVIOUS=${1:-$DEFAULT_PREVIOUS}
WORK=${2:-tests/m247Performance/runs/${TAG}-$(date +%Y%m%d-%H%M%S)}
JOBS=${3:-48}
[[ "$JOBS" =~ ^[1-9][0-9]*$ ]] || { echo "JOBS must be positive" >&2; exit 1; }
[[ ! -e "$WORK" ]] || { echo "Choose a fresh WORK: $WORK" >&2; exit 1; }
mkdir -p "$WORK"
WORK=$(cd "$WORK" && pwd)
bundle_on_exit() {
    local status=$?
    trap - EXIT
    if ! python3 tests/m247Performance/package_results.py --work "$WORK" --exit-code "$status"; then
        if [[ "$status" -eq 0 ]]; then status=1; fi
    fi
    exit "$status"
}
trap bundle_on_exit EXIT
{
    echo "WM_PROJECT_DIR=${WM_PROJECT_DIR:-unset}"
    echo "FOAM_USER_APPBIN=${FOAM_USER_APPBIN:-unset}"
    echo "previous=$PREVIOUS"
    echo "max_delta_ns=$MAX_DELTA_NS; collection_only=$RESUME; new pilot duration=${DURATION_US}us; no speedup pair"
    git rev-parse HEAD || true
} > "$WORK/buildEnvironment.txt"
if [[ "$RESUME" == true ]]; then
    python3 tests/m247Performance/moving_cfd.py --resume --previous "$PREVIOUS" --work "$WORK" \
        2>&1 | tee "$WORK/collection.log"
    exit 0
fi
( cd applications/solvers/vacuumLaserbeamFoam && wclean && wmake -j "$JOBS" ) \
    2>&1 | tee "$WORK/build.log"
SOLVER=${FOAM_USER_APPBIN:?Source OpenFOAM}/vacuumLaserbeamFoam
sha256sum "$SOLVER" applications/solvers/vacuumLaserbeamFoam/m247MovingRefineFvMesh.H > "$WORK/previewBinary.txt"
python3 tests/m247Performance/moving_cfd.py --previous "$PREVIOUS" --work "$WORK" \
    --solver "$SOLVER" --max-delta-ns "$MAX_DELTA_NS" --duration-us "$DURATION_US" 2>&1 | tee "$WORK/collection.log"
