#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/../.."
if [ "$#" -ne 2 ]; then
    echo "Usage: bash tests/m247Performance/RunM247LocalCorridorPilot DEM_REVIEW.tar.gz V2_50US_REVIEW.tar.gz" >&2
    exit 2
fi
DEM_ARCHIVE=$(realpath "$1")
BASELINE_ARCHIVE=$(realpath "$2")
test -f "$DEM_ARCHIVE" || { echo "Missing DEM archive: $DEM_ARCHIVE" >&2; exit 2; }
test -f "$BASELINE_ARCHIVE" || { echo "Missing V2 baseline archive: $BASELINE_ARCHIVE" >&2; exit 2; }
WORK=tests/m247Performance/runs/m247-local-corridor-pilot-$(date +%Y%m%d-%H%M%S)
mkdir -p "$WORK"
WORK=$(cd "$WORK" && pwd -P)
package() {
    code=$?
    trap - EXIT
    python3 tests/m247Performance/track1500_local_corridor.py --work "$WORK" --package --exit-code "$code" || code=1
    exit "$code"
}
trap package EXIT
git rev-parse HEAD > "$WORK/revision.txt"
printf 'WM_PROJECT_VERSION=%s\nWM_PROJECT_DIR=%s\nWMAKE=%s\n' "${WM_PROJECT_VERSION:-unset}" "${WM_PROJECT_DIR:-unset}" "$(command -v wmake || printf unset)" > "$WORK/openfoamVersion.txt"
case "${WM_PROJECT_VERSION:-}" in
    v2512|2512) ;;
    *) echo "M247 local corridor requires OpenFOAM-v2512; current=${WM_PROJECT_VERSION:-unset}" >&2; exit 2 ;;
esac
if [ ! -d "${WM_PROJECT_DIR:-}" ] || [ "$(basename "$WM_PROJECT_DIR")" != OpenFOAM-v2512 ]; then
    echo "M247 local corridor requires v2512 WM_PROJECT_DIR; current=${WM_PROJECT_DIR:-unset}" >&2
    exit 2
fi
WMAKE_PATH=$(command -v wmake || true)
if [ -z "$WMAKE_PATH" ] || [ "$(realpath "$WMAKE_PATH")" != "$(realpath "$WM_PROJECT_DIR/wmake/wmake")" ]; then
    echo "M247 local corridor requires v2512 wmake; current=${WMAKE_PATH:-unset}" >&2
    exit 2
fi
python3 tests/m247Performance/m247_dem_handoff.py "$DEM_ARCHIVE" "$WORK/dem"
python3 tests/m247Performance/local_corridor_compare.py --baseline "$BASELINE_ARCHIVE" --dem "$DEM_ARCHIVE" --output "$WORK/baselinePreflight.json"
for tool in python3 wclean wmake wmakeLnInclude blockMesh setFields checkMesh decomposePar mpirun reconstructPar postProcess; do
    command -v "$tool" >/dev/null || { echo "Missing $tool; source OpenFOAM-v2512 first" >&2; exit 1; }
done
(cd src/laserHeatSource && wclean libso && wmakeLnInclude -u . && test -r lnInclude/laserPerformance.H && wmake libso) 2>&1 | tee "$WORK/buildLaser.log"
(cd applications/solvers/vacuumLaserbeamFoam && wclean && wmake) 2>&1 | tee "$WORK/buildSolver.log"
python3 tests/m247Performance/check_solver.py --laser-profile --output "$WORK/solverCheck.json"
python3 tests/m247Performance/track1500_local_corridor.py --work "$WORK" 2>&1 | tee "$WORK/collection.log"
python3 tests/m247Performance/local_corridor_compare.py --baseline "$BASELINE_ARCHIVE" --candidate "$WORK" --output "$WORK/comparison.json" 2>&1 | tee "$WORK/comparison.log"

