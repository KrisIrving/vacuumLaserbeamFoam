#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
SOURCE_CASE="$REPO_ROOT/tutorials/vacuumLaserbeamFoam/bootstrapPlate2D"
RUN_CASE="$REPO_ROOT/tests/run/wang304LReference"

rm -rf "$RUN_CASE"
mkdir -p "$(dirname "$RUN_CASE")"
cp -a "$SOURCE_CASE" "$RUN_CASE"
cp "$SCRIPT_DIR/vacuumProperties" "$RUN_CASE/constant/vacuumProperties"

# Wang Table II: 304L liquidus = 1727 K.
sed -i '0,/Tliquidus[[:space:]]*1723;/s//Tliquidus           1727;/'     "$RUN_CASE/constant/transportProperties"

(
    cd "$RUN_CASE"
    blockMesh > log.blockMesh 2>&1
)

run_model()
{
    local temperature="$1"
    local label="$2"

    # Preserve the high-precision component constants: foamDictionary
    # rewrites the full dictionary with lower output precision.
    sed -i -E "s/^testTemperature[[:space:]]+[^;]+;/testTemperature      $temperature;/" "$RUN_CASE/constant/vacuumProperties"

    (
        cd "$RUN_CASE"
        vacuumEvaporationModelTest > "log.model.$label" 2>&1
    )

    grep '^EVAP_MODEL_TEST ' "$RUN_CASE/log.model.$label" | tail -1
}

check_state()
{
    local temperature="$1"
    local label="$2"
    local ePsat="$3"
    local eMdot="$4"
    local eRecoil="$5"
    local eQ="$6"

    local line
    line="$(run_model "$temperature" "$label")"
    read -r tag T pSat mDot recoil qEvap <<< "$line"

    awk         -v T="$T"         -v targetT="$temperature"         -v pSat="$pSat"         -v mDot="$mDot"         -v recoil="$recoil"         -v q="$qEvap"         -v ePsat="$ePsat"         -v eMdot="$eMdot"         -v eRecoil="$eRecoil"         -v eQ="$eQ" '
    BEGIN {
        tol=8e-8;
        if (T != targetT) exit 11;
        if (sqrt((pSat-ePsat)^2) > tol*(ePsat>1?ePsat:1)) exit 12;
        if (sqrt((mDot-eMdot)^2) > tol*(eMdot>1?eMdot:1)) exit 13;
        if (sqrt((recoil-eRecoil)^2) > tol*(eRecoil>1?eRecoil:1)) exit 14;
        if (sqrt((q-eQ)^2) > tol*(eQ>1?eQ:1)) exit 15;
    }'

    grep -q "component mode       = Wang Eqs. (18)-(20)"         "$RUN_CASE/log.model.$label"
    grep -q "active regime        = common-to-sonic (Wang step 4)"         "$RUN_CASE/log.model.$label"
}

# Table-II anchor: Pe(2009 K) = 20.16 Pa. Chamber pressure is slightly higher,
# so liquid evaporation remains inactive at exactly 2009 K.
check_state     2009     tableIIAnchor     20.16     0     0     0

# Regression for the exact low-Mach endpoint that previously failed in the
# 4-um CFD run. At the chamber-pressure boiling point the Wang common-atmosphere
# solution approaches Ma=0 continuously; the state must remain finite.
boundary_line="$(run_model 2009.503556 boilingEndpoint)"
if [ -z "$boundary_line" ]; then
    echo "No constitutive output at Wang boiling endpoint" >&2
    exit 21
fi
read -r tag T pSat mDot recoil qEvap <<< "$boundary_line"
awk -v pSat="$pSat" -v mDot="$mDot" -v recoil="$recoil" -v q="$qEvap" '
BEGIN {
    if (!(pSat > 0)) exit 22;
    if (!(mDot >= 0)) exit 23;
    if (!(recoil >= 0)) exit 24;
    if (!(q >= 0)) exit 25;
}'


# Wang near-vacuum step (4): Tb < T < Tk0, so Ma is below 0.05 but non-zero.
check_state     2020     lowMachCommonAtmosphere     22.56936343153303     0.0008801890121715992     1.572972736944557     5598.002117411371

# Intermediate transition state.
check_state     2300     transition     278.15168769309065     0.14104477101452056     143.66729527505754     897044.7436523507

# Above Tk1 the model must be sonic.
check_state     3000     sonic     19211.032674783848     9.252648301740672     10542.464063561532     58846843.19907068

grep -q "alloy Pe anchor       = 20.16 Pa at 2009 K"     "$RUN_CASE/log.model.lowMachCommonAtmosphere"

echo "PASS: Wang 304L Table-I/II anchored constitutive reference"
