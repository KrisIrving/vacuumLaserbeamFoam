#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
GENERATOR="$REPO_ROOT/tools/powderBed/generatePowderBed.py"
CONFIG="$SCRIPT_DIR/powderBedConfig.json"
RUN_DIR="$REPO_ROOT/tests/run/powderBedGenerator"

rm -rf "$RUN_DIR"
mkdir -p "$RUN_DIR/first" "$RUN_DIR/second"

run_generation()
{
    out="$1"
    python3 "$GENERATOR" \
        --config "$CONFIG" \
        --set-fields "$out/setFieldsDict" \
        --particles "$out/powderParticles.csv" \
        --manifest "$out/powderManifest.json"
}

echo "Generating first powder bed"
run_generation "$RUN_DIR/first" | tee "$RUN_DIR/log.first"

echo "Generating second powder bed with identical seed"
run_generation "$RUN_DIR/second" | tee "$RUN_DIR/log.second"

cmp "$RUN_DIR/first/setFieldsDict" "$RUN_DIR/second/setFieldsDict"
cmp "$RUN_DIR/first/powderParticles.csv" "$RUN_DIR/second/powderParticles.csv"
cmp "$RUN_DIR/first/powderManifest.json" "$RUN_DIR/second/powderManifest.json"

python3 - "$RUN_DIR/first/powderManifest.json" "$RUN_DIR/first/setFieldsDict" <<'PY'
import json
import pathlib
import sys

manifest = json.loads(pathlib.Path(sys.argv[1]).read_text())
set_fields = pathlib.Path(sys.argv[2]).read_text()

count = manifest["particleCount"]
sphere_count = set_fields.count("sphereToCell")

if count != 56:
    raise SystemExit(f"Unexpected deterministic particle count: {count} != 56")
if sphere_count != count:
    raise SystemExit(
        f"setFields sphere count {sphere_count} != manifest particle count {count}"
    )

sf = manifest["actualSolidFraction"]
if not (0.22 <= sf < 0.23):
    raise SystemExit(f"Unexpected solid fraction: {sf}")

if manifest["minimumInterparticleGap_m"] < -1e-12:
    raise SystemExit(
        f"Overlap detected: {manifest['minimumInterparticleGap_m']} m"
    )

if manifest["highestParticleTop_m"] > 260e-6 + 1e-12:
    raise SystemExit(
        f"Layer thickness exceeded: {manifest['highestParticleTop_m']} m"
    )

for name in ("diameterD10_m", "diameterD50_m", "diameterD90_m"):
    if not (24e-6 <= manifest[name] <= 44e-6):
        raise SystemExit(f"PSD statistic outside configured support: {name}")

print(
    "PASS: deterministic powder generator "
    f"particles={count} "
    f"solidFraction={sf:.8g} "
    f"D10={1e6*manifest['diameterD10_m']:.4g}um "
    f"D50={1e6*manifest['diameterD50_m']:.4g}um "
    f"D90={1e6*manifest['diameterD90_m']:.4g}um"
)
PY
