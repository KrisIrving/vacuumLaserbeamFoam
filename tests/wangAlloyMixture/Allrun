#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
SOURCE_CASE="$REPO_ROOT/tutorials/vacuumLaserbeamFoam/bootstrapPlate2D"
RUN_CASE="$REPO_ROOT/tests/run/wangAlloyMixture"

rm -rf "$RUN_CASE"
mkdir -p "$(dirname "$RUN_CASE")"
cp -a "$SOURCE_CASE" "$RUN_CASE"
cp "$SCRIPT_DIR/vacuumProperties" "$RUN_CASE/constant/vacuumProperties"

(
    cd "$RUN_CASE"
    blockMesh > log.blockMesh 2>&1
)

run_model()
{
    local temperature="$1"
    local label="$2"

    foamDictionary "$RUN_CASE/constant/vacuumProperties"         -entry testTemperature -set "$temperature" > /dev/null

    (
        cd "$RUN_CASE"
        vacuumEvaporationModelTest > "log.model.$label" 2>&1
    )

    grep '^EVAP_MODEL_TEST ' "$RUN_CASE/log.model.$label" | tail -1
}

check_state()
{
    local temperature="$1"
    local label="$2"
    local ePsat="$3"
    local eMdot="$4"
    local eRecoil="$5"
    local eQ="$6"

    local line
    line="$(run_model "$temperature" "$label")"
    read -r tag T pSat mDot recoil qEvap <<< "$line"

    awk         -v T="$T"         -v targetT="$temperature"         -v pSat="$pSat"         -v mDot="$mDot"         -v recoil="$recoil"         -v q="$qEvap"         -v ePsat="$ePsat"         -v eMdot="$eMdot"         -v eRecoil="$eRecoil"         -v eQ="$eQ" '
    BEGIN {
        tol=5e-9;
        if (T != targetT) exit 11;
        if (sqrt((pSat-ePsat)^2) > tol*ePsat) exit 12;
        if (sqrt((mDot-eMdot)^2) > tol*eMdot) exit 13;
        if (sqrt((recoil-eRecoil)^2) > tol*eRecoil) exit 14;
        if (sqrt((q-eQ)^2) > tol*eQ) exit 15;
    }'

    grep -q "component mode       = Wang Eqs. (18)-(20)"         "$RUN_CASE/log.model.$label"
    grep -q "alloy components     = A(k=0.75) B(k=0.25)"         "$RUN_CASE/log.model.$label"
}

# Independent constants are calculated directly from:
#   ki = (wi/Mi)/sum(wj/Mj)
#   Pi = Pref_i exp[Lvi Mi/Rmol (1/Tref_i - 1/T)]
#   Pe = sum(ki Pi)
#   M  = sum(Mi ki Pi)/Pe
# followed by the corrected Ma=1 Wang Knudsen jump.
check_state     2500     alloy2500     55558.57752623348     29.493003662234916     30546.96147163161     20645102.563564442

check_state     3000     alloy3000     74371.69649673795     36.7578266908506     40890.907155864545     25730478.68359542

echo "PASS: Wang Eqs. (18)-(20) alloy saturation/molar-mass regression"
