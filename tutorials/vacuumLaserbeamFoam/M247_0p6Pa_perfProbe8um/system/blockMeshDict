FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object blockMeshDict;
}

convertToMeters 1;

// 200-us extension after the 100-us liquidus envelope reached x=-200 um.
// x is kept uniformly at 8 um to avoid a grading transition inside the
// thermally active wake. The already validated transverse shoulders are kept.

vertices
(
    // z = -320 um
    (-520e-6 0       -320e-6)
    ( 320e-6 0       -320e-6)
    ( 320e-6 960e-6  -320e-6)
    (-520e-6 960e-6  -320e-6)

    // z = -160 um
    (-520e-6 0       -160e-6)
    ( 320e-6 0       -160e-6)
    ( 320e-6 960e-6  -160e-6)
    (-520e-6 960e-6  -160e-6)

    // z = +160 um
    (-520e-6 0        160e-6)
    ( 320e-6 0        160e-6)
    ( 320e-6 960e-6   160e-6)
    (-520e-6 960e-6   160e-6)

    // z = +320 um
    (-520e-6 0        320e-6)
    ( 320e-6 0        320e-6)
    ( 320e-6 960e-6   320e-6)
    (-520e-6 960e-6   320e-6)
);

blocks
(
    // Negative-z shoulder.
    hex (0 1 2 3 4 5 6 7)
        (105 120 10)
        simpleGrading (1 1 0.3333333333)

    // Central z corridor: 8 um.
    hex (4 5 6 7 8 9 10 11)
        (105 120 40)
        simpleGrading (1 1 1)

    // Positive-z shoulder.
    hex (8 9 10 11 12 13 14 15)
        (105 120 10)
        simpleGrading (1 1 3)
);

edges ();

boundary
(
    bottomWall
    {
        type wall;
        faces
        (
            (0 4 5 1)
            (4 8 9 5)
            (8 12 13 9)
        );
    }

    atmosphere
    {
        type patch;
        faces
        (
            (3 2 6 7)
            (7 6 10 11)
            (11 10 14 15)
        );
    }

    sideWalls
    {
        type patch;
        faces
        (
            (0 3 7 4)
            (4 7 11 8)
            (8 11 15 12)

            (1 5 6 2)
            (5 9 10 6)
            (9 13 14 10)

            (0 1 2 3)
            (12 15 14 13)
        );
    }
);

mergePatchPairs ();
