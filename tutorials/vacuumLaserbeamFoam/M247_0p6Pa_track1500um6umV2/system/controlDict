FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system";
    object controlDict;
}

application vacuumLaserbeamFoam;

startFrom startTime;
startTime 0;
stopAt endTime;
endTime 50e-6;

deltaT 1e-9;

writeControl adjustableRunTime;
writeInterval 10e-6;

purgeWrite 0;
writeFormat binary;
writePrecision 17;
writeCompression off;
timeFormat general;
timePrecision 10;
runTimeModifiable yes;

adjustTimeStep yes;
maxCo 0.1;
maxAlphaCo 0.1;
maxDeltaT 1e-7;

laserRefreshIntervalSteps 1;

thermalInvariantCache false;

frozenLaserProbe off;
