FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system";
    object meltPoolInterfaceDict;
}

functions
{
    liquidusSurface
    {
        type surfaces;
        libs (sampling);

        surfaceFormat obj;
        sampleScheme cell;
        interpolationScheme cellPoint;

        fields (T);

        surfaces
        {
            liquidus
            {
                type isoSurface;
                isoField T;
                isoValue 1631;
                isoMethod topo;
                triangulate true;
            }
        }
    }
}
