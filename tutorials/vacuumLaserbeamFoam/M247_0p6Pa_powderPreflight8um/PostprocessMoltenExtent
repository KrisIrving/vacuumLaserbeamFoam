#!/bin/bash
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

echo "Checking reconstructed T field"
latestTime="$(foamListTimes -latestTime | tail -1)"
if [ ! -f "$latestTime/T" ]; then
    echo "Reconstructing T because $latestTime/T is missing"
    reconstructPar -fields '(T)' -time '5e-6:' > log.reconstructPar.T 2>&1
fi

echo "Sampling T=1631 K liquidus-temperature envelope"
rm -rf postProcessing/moltenRegionSurface
postProcess -dict system/moltenRegionSurfaceDict -fields '(T)' -time '5e-6:' \
    > log.postProcess.moltenExtent 2>&1

echo "Extracting molten-envelope clearances"
python3 scripts/extractMoltenExtent.py \
    --post-processing postProcessing/moltenRegionSurface \
    --xmin=-200e-6 --xmax=200e-6 \
    --ymin=0 --ymax=960e-6 \
    --zmin=-320e-6 --zmax=320e-6 \
    --output moltenExtent.csv

echo
tail -5 moltenExtent.csv
