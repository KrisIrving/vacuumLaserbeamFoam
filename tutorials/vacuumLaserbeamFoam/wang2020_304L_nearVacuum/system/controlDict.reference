FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system";
    object controlDict;
}

application vacuumLaserbeamFoam;

startFrom startTime;
startTime 0;
stopAt endTime;

// Covers the 70-75 us 32-to-136 um growth interval with margin.
endTime 120e-6;
deltaT 1e-9;

writeControl adjustableRunTime;
writeInterval 2e-6;

purgeWrite 0;
writeFormat binary;
writePrecision 10;
writeCompression off;
timeFormat general;
timePrecision 10;
runTimeModifiable yes;

adjustTimeStep yes;
maxCo 0.1;
maxAlphaCo 0.1;
maxDeltaT 1e-7;
