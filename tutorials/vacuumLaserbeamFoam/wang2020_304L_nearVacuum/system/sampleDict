FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system";
    object sampleDict;
}

type sets;
libs (sampling);
interpolationScheme cellPoint;
setFormat raw;

sets
(
    keyholeCenterline
    {
        type uniform;
        axis xyz;
        start (0 240e-6 0);
        end   (0 0 0);
        nPoints 481;
    }
);

fields (alpha.metal);
