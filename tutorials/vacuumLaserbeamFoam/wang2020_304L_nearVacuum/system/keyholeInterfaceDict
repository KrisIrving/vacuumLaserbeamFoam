FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system";
    object keyholeInterfaceDict;
}

functions
{
    keyholeInterface
    {
        type surfaces;
        libs (sampling);

        surfaceFormat obj;
        sampleScheme cell;
        interpolationScheme cellPoint;

        fields (alpha.metal);

        surfaces
        {
            metalGasInterface
            {
                type isoSurface;
                isoField alpha.metal;
                isoValue 0.5;
                isoMethod topo;
                triangulate true;
            }
        }
    }
}
