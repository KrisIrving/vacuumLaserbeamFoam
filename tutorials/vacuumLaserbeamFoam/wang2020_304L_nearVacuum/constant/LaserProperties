FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "constant";
    object LaserProperties;
}

radialPolarHeatSource yes;
PowderSim false;

timeVsLaserPosition
{
    file "$FOAM_CASE/constant/timeVsLaserPosition";
    outOfBounds clamp;
}

timeVsLaserPower
{
    file "$FOAM_CASE/constant/timeVsLaserPower";
    outOfBounds clamp;
}

V_incident (0 -1 0);
laserRadius 50e-6;
Radius_Flavour 2.3;

nRadial 16;
nAngular 96;
N_sub_divisions 1;

wavelength 1.070e-6;

// Wang-validation optical closure. Wang et al. use iron optical constants
// as the 304L surrogate. Johnson-Christy Fe data interpolated from
// 0.984 and 1.088 um to 1.070 um:
opticalModel fixedComplexIndex;
refractiveIndex 2.961346153846154;
extinctionCoefficient 4.013269230769231;

// Retained for easy fallback to opticalModel drudeResistivity.
e_num_density 5.83e29;

dep_cutoff 0.5;
useLocalSearch true;
maxLocalSearch 200;
rayPowerRelTol 1e-6;
