#!/bin/bash

. $WM_PROJECT_DIR/bin/tools/RunFunctions

echo "Preparing 4 um reference dictionaries"
cp system/blockMeshDict.reference4um system/blockMeshDict
cp system/controlDict.reference system/controlDict

echo "Copying 'initial' to 0"
cp -r initial 0

runApplication blockMesh
runApplication setFields
runApplication decomposePar
runParallel vacuumLaserbeamFoam
