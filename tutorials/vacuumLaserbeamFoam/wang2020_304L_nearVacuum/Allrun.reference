#!/bin/bash
set -eo pipefail
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

NP=48

rm -rf 0 processor* postProcessing
cp -r initial 0

controlBackup="$(mktemp)"
cp system/controlDict "$controlBackup"
restore_control()
{
    cp "$controlBackup" system/controlDict
    rm -f "$controlBackup"
}
trap restore_control EXIT
cp system/controlDict.reference system/controlDict

runApplication blockMesh -dict system/blockMeshDict.reference4um
runApplication setFields
runApplication decomposePar -dict system/decomposeParDict.reference -force

mpirun -np "$NP" vacuumLaserbeamFoam -parallel 2>&1 | tee log.vacuumLaserbeamFoam.parallel
