#!/bin/bash

LOG=log.vacuumLaserbeamFoam

if [ -f run.pid ]; then
    PID=$(cat run.pid)
    if ps -p "$PID" > /dev/null 2>&1; then
        echo "Run status            : running (PID $PID)"
    else
        echo "Run status            : not running"
    fi
else
    echo "Run status            : foreground/unknown"
fi

if [ ! -f "$LOG" ]; then
    echo "No $LOG yet."
    exit 0
fi

printf 'Latest simulation time: '
grep '^[[:space:]]*Time = ' "$LOG" | tail -1

printf 'Latest execution time : '
grep 'ExecutionTime = ' "$LOG" | tail -1

printf 'Latest deltaT         : '
grep 'deltaT = ' "$LOG" | tail -1

printf 'Latest diagnostics    : '
grep '^VACUUM_DIAGNOSTICS ' "$LOG" | tail -1

printf 'Latest laser deposit  : '
grep 'Total Q deposited this timestep:' "$LOG" | tail -1
