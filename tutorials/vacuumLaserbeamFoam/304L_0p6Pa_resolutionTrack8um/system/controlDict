FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system";
    object controlDict;
}

application vacuumLaserbeamFoam;

startFrom latestTime;
startTime 0;
stopAt endTime;
endTime 100e-6;

deltaT 5e-10;

writeControl adjustableRunTime;
writeInterval 5e-6;

purgeWrite 0;
writeFormat binary;
writePrecision 10;
writeCompression off;
timeFormat general;
timePrecision 10;
runTimeModifiable yes;

adjustTimeStep yes;
maxCo 0.1;
maxAlphaCo 0.1;
maxDeltaT 5e-8;
