#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

if ! find postProcessing/movingKeyholeInterface -type f -name '*.obj' 2>/dev/null | grep -q .
then
    echo "Existing moving-keyhole OBJ samples not found." >&2
    echo "Run ./PostprocessTrack first." >&2
    exit 1
fi

for W in 80 100 120 160 200
do
    echo "Analyzing trailing window ${W} um"
    python3 scripts/extractMovingKeyholeDepth.py \
        --post-processing postProcessing/movingKeyholeInterface \
        --laser-path constant/timeVsLaserPosition \
        --surface-y 200e-6 \
        --surface-band 8e-6 \
        --trailing-window "${W}e-6" \
        --forward-window 60e-6 \
        --half-width-z 75e-6 \
        --output "movingKeyholeDepth.trailing${W}um.csv"
done

python3 scripts/compareMovingKeyholeWindows.py \
    --inputs \
        movingKeyholeDepth.trailing80um.csv \
        movingKeyholeDepth.trailing100um.csv \
        movingKeyholeDepth.trailing120um.csv \
        movingKeyholeDepth.trailing160um.csv \
        movingKeyholeDepth.trailing200um.csv \
    --labels 80um 100um 120um 160um 200um \
    --output movingKeyholeWindowSensitivity.csv
