#!/bin/bash

echo "Reconstructing alpha.metal time directories"
reconstructPar -fields '(alpha.metal)' -time '5e-6:' -newTimes > log.reconstructPar.alpha 2>&1

echo "Sampling complete alpha.metal=0.5 interface"
rm -rf postProcessing/movingKeyholeInterface
postProcess \
    -dict system/movingKeyholeInterfaceDict \
    -fields '(alpha.metal)' \
    -time '5e-6:' \
    > log.postProcess.movingKeyhole 2>&1

if ! find postProcessing/movingKeyholeInterface -type f -name '*.obj' 2>/dev/null | grep -q .
then
    echo "ERROR: moving keyhole interface OBJ files were not generated." >&2
    echo "Check log.postProcess.movingKeyhole" >&2
    exit 1
fi

python3 scripts/extractMovingKeyholeDepth.py \
    --post-processing postProcessing/movingKeyholeInterface \
    --laser-path constant/timeVsLaserPosition \
    --surface-y 200e-6 \
    --surface-band 8e-6 \
    --trailing-window 100e-6 \
    --forward-window 60e-6 \
    --half-width-z 75e-6 \
    --output movingKeyholeDepth.csv

echo
echo "Wrote movingKeyholeDepth.csv"
tail -5 movingKeyholeDepth.csv
